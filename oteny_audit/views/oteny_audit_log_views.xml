<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id='oteny_audit_log_view_list' model='ir.ui.view'>
        <field name='name'>oteny.audit.log.list</field>
        <field name='model'>oteny.audit.log</field>
        <field name='arch' type='xml'>
            <list string="Audit Log" create="false" edit="false">
                <field name="create_date" string="Timestamp" optional="show" />
                <field name="create_uid" string="User" optional="show" widget="many2one_avatar_user" />
                <field name="transaction_id" string="Transaction ID" optional="hide" />
                <field name="model_name" optional="show" />
                <field name="record_id" optional="show" />
                <field name="record_display_name" optional="show" />
                <field name="field_name" optional="hide" />
                <field name="field_display_name" optional="show" />
                <field name="old_value" optional="hide" />
                <field name="old_value_display_name" optional="show" />
                <field name="new_value" optional="hide" />
                <field name="new_value_display_name" optional="show" />
                <field name="change_type" optional="show" />
            </list>
        </field>
    </record>

    <record id='oteny_audit_log_view_form' model='ir.ui.view'>
        <field name="name">oteny.audit.log.form</field>
        <field name="model">oteny.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Timestamp" readonly="1" />
                            <field name="create_uid" string="User" readonly="1" widget="many2one_avatar_user" />
                            <field name="change_type" readonly="1" />
                        </group>
                        <group>
                            <field name="record_ref" readonly="1" />
                            <field name="record_display_name" readonly="1" />
                            <field name="field_display_name" readonly="1" />
                            <field name="field_name" readonly="1" />
                        </group>
                    </group>
                    <group string="Changed Values">
                        <label for="old_value" />
                        <div>
                            <field name="old_value" readonly="1" class="oe_inline" />
                            <field name="old_value_display_name" readonly="1" class="oe_inline" invisible="old_value == old_value_display_name" />
                        </div>
                        <label for="new_value" />
                        <div>
                            <field name="new_value" readonly="1" class="oe_inline" />
                            <field name="new_value_display_name" readonly="1" class="oe_inline" invisible="new_value == new_value_display_name" />
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oteny_audit_log_view_search" model="ir.ui.view">
        <field name="name">oteny.audit.log.search</field>
        <field name="model">oteny.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">
                <field name="model_name" />
                <field name="field_name" />
                <field name="field_display_name" />
                <field name="record_id" />
                <field name="record_display_name" />
                <field name="change_type" />
                <field name="old_value" />
                <field name="new_value" />
                <field name="old_value_display_name" />
                <field name="new_value_display_name" />
                <field name="create_uid" />
                <separator />
                <filter string="Today" name="filter_today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]" />
                <filter string="From Yesterday onwards" name="filter_from_yesterday" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]" />
                <filter string="Last week" name="filter_last_week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <filter string="Last month" name="filter_last_month" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]" />
                <separator />
                <filter string="Inserts" name="inserts" domain="[('change_type', '=', 'i')]" />
                <filter string="Updates" name="updates" domain="[('change_type', '=', 'u')]" />
                <filter string="Deletes" name="deletes" domain="[('change_type', '=', 'd')]" />
                <filter string="Remarks" name="remarks" domain="[('change_type', '=', 'r')]" />
                <separator />
                <group>
                    <filter string="Model" name="group_by_model" context="{'group_by': 'model_name'}" />
                    <filter string="Record" name="group_by_record" context="{'group_by': 'record_display_name'}" />
                    <filter string="Field" name="group_by_field" context="{'group_by': 'field_display_name'}" />
                    <filter string="Change Type" name="group_by_change_type" context="{'group_by': 'change_type'}" />
                    <filter string="User" name="group_by_user" context="{'group_by': 'create_uid'}" />
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}" />
                    <filter string="Transaction ID" name="group_by_transaction_id" context="{'group_by': 'transaction_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_oteny_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="path">audit-raw</field>
        <field name="res_model">oteny.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'search_default_filter_from_yesterday': 1}</field>
        <field name="search_view_id" ref="oteny_audit_log_view_search" />
    </record>

    <!-- Search View for Aggregated Audit Log -->
    <record id="view_oteny_audit_log_aggregated_search" model="ir.ui.view">
        <field name="name">oteny.audit.log.aggregated.search</field>
        <field name="model">oteny.audit.log.aggregated</field>
        <field name="arch" type="xml">
            <search string="Search Aggregated Audit Log">
                <field name="model_name" />
                <field name="model_display_name" />
                <field name="parent_record_display_name" />
                <field name="record_display_name" />
                <field name="field_display_name" />
                <field name="field_model_name" />
                <field name="field_model_display_name" />
                <field name="change_type" />
                <field name="old_value_display_name" />
                <field name="new_value_display_name" />
                <field name="create_uid" />
                <field name="is_child_log" />
                <field name="child_model_name" />
                <separator />
                <filter string="Today" name="filter_today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]" />
                <filter string="From Yesterday onwards" name="filter_from_yesterday" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]" />
                <filter string="Last week" name="filter_last_week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <filter string="Last month" name="filter_last_month" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]" />
                <separator />
                <filter string="Inserts" name="inserts" domain="[('change_type', '=', 'i')]" />
                <filter string="Updates" name="updates" domain="[('change_type', '=', 'u')]" />
                <filter string="Deletes" name="deletes" domain="[('change_type', '=', 'd')]" />
                <filter string="Remarks" name="remarks" domain="[('change_type', '=', 'r')]" />
                <filter string="Child Logs" name="child_logs" domain="[('is_child_log', '=', True)]" />
                <filter string="Parent Logs" name="parent_logs" domain="[('is_child_log', '=', False)]" />
                <separator />
                <group>
                    <filter string="Parent Model" name="group_by_parent_model" context="{'group_by': 'model_display_name'}" />
                    <filter string="Parent Record" name="group_by_parent_record" context="{'group_by': 'parent_record_display_name'}" />
                    <filter string="Record" name="group_by_record" context="{'group_by': 'record_display_name'}" />
                    <filter string="Field" name="group_by_field" context="{'group_by': 'field_display_name'}" />
                    <filter string="Field Model" name="group_by_field_model" context="{'group_by': 'field_model_display_name'}" />
                    <filter string="Change Type" name="group_by_change_type" context="{'group_by': 'change_type'}" />
                    <filter string="User" name="group_by_user" context="{'group_by': 'create_uid'}" />
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}" />
                    <filter string="Transaction ID" name="group_by_transaction_id" context="{'group_by': 'transaction_id'}" />
                    <filter string="Child Model" name="group_by_child_model" context="{'group_by': 'child_model_display_name'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- List View for Aggregated Audit Log -->
    <record id="view_oteny_audit_log_aggregated_list" model="ir.ui.view">
        <field name="name">oteny.audit.log.aggregated.list</field>
        <field name="model">oteny.audit.log.aggregated</field>
        <field name="arch" type="xml">
            <list string="Aggregated Audit Log">
                <!-- <field name="highlight_row" column_invisible="1" />
                <field name="highlight_row_type" column_invisible="1" /> -->
                <field name="caption" widget="html" optional="show" />
                <field name="create_date" string="Timestamp" optional="hide" width="100px" />
                <field name="create_uid" string="User" optional="hide" width="100px" />
                <field name="model_display_name" optional="hide" width="150px" />
                <field name="record_id" optional="hide" width="100px" />
                <field name="parent_record_display_name" optional="hide" width="400px" />
                <field name="field_model_display_name" optional="hide" width="150px" />
                <field name="record_display_name" optional="hide" width="400px" />
                <field name="change_type" optional="hide" width="30px" />
                <field name="field_display_name" optional="hide" width="200px" />
                <field name="old_value_display_name" optional="hide" width="250px" />
                <field name="new_value_display_name" optional="hide" width="250px" />
                <field name="transaction_id" optional="hide" width="100px" />
                <field name="audit_log_id" optional="hide" width="170px" />
            </list>
        </field>
    </record>

    <!-- Form View for Aggregated Audit Log -->
    <record id="view_oteny_audit_log_aggregated_form" model="ir.ui.view">
        <field name="name">oteny.audit.log.aggregated.form</field>
        <field name="model">oteny.audit.log.aggregated</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Timestamp" />
                            <field name="transaction_id" groups="base.group_no_one" />
                            <field name="audit_log_id" groups="base.group_no_one" />
                            <field name="create_uid" string="User" />
                            <field name="change_type" />
                        </group>
                        <group>
                            <field name="model_display_name" invisible="not is_child_log" />
                            <field name="parent_record_display_name" invisible="not is_child_log" />
                            <field name="record_display_name" />
                        </group>
                    </group>
                    <group>
                        <group string="Changed Field Values">
                            <field name="record_ref" />
                            <field name="is_child_log" invisible="1" />
                            <field
                                name="child_record_ref"
                                string="Child Record"
                                invisible="not is_child_log"
                            />
                            <field name="field_model_display_name" />
                            <field name="field_display_name" />
                            <field name="old_value_display_name" />
                            <field name="new_value_display_name" />
                        </group>
                        <group string="Raw Field Values">
                            <field name="record_id" />
                            <field name="field_model_name" />
                            <field name="field_name" groups="base.group_no_one" />
                            <field name="old_value" />
                            <field name="new_value" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action for Aggregated Audit Log -->
    <record id="action_oteny_audit_log_aggregated" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="path">audit-log</field>
        <field name="res_model">oteny.audit.log.aggregated</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'search_default_filter_from_yesterday': 1}</field>
        <field name="domain">[('is_child_log', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No audit logs found
            </p>
            <p>
                This view shows all direct audit log entries. Child logs are only shown when viewing from a specific parent record.
            </p>
        </field>
        <field name="search_view_id" ref="view_oteny_audit_log_aggregated_search" />
    </record>

    <record id="action_oteny_audit_log_install" model="ir.actions.server">
        <field name="name">Enable Audit Log for all models</field>
        <field name="model_id" ref="base.model_ir_model" />
        <field name="binding_model_id" ref="model_oteny_audit_log" />
        <field name="state">code</field>
        <field name="code">
            action = env['oteny.audit.log'].install_for_all_models_action()
        </field>
    </record>


    <menuitem
        id="oteny_audit_log_menu_root"
        name="Audit"
        sequence="99"
        web_icon="oteny_audit,static/description/icon.png"
    />

    <menuitem
        id="oteny_audit_log_menu"
        name="Log"
        parent="oteny_audit_log_menu_root"
        action="oteny_audit.action_oteny_audit_log_aggregated"
        sequence="10"
    />


    <menuitem
        id="oteny_audit_log_config_menu"
        name="Configuration"
        parent="oteny_audit_log_menu_root"
        sequence="20"
    >

        <menuitem
            id="oteny_audit_log_config_menu_settings"
            name="Settings"
            action="action_oteny_audit_config_settings"
            sequence="5"
        />
        <menuitem
            id="oteny_audit_log_raw_menu"
            name="Plain Audit Log"
            action="action_oteny_audit_log"
            sequence="15"
        />
        <menuitem
            id="oteny_audit_log_config_menu_install"
            name="Enable Audit Log for all models"
            action="action_oteny_audit_log_install"
            groups="base.group_no_one"
            sequence="10"
        />
    </menuitem>

</odoo>