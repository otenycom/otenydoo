<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]/Dropdown" position="replace">
            <a href="/odoo/home" class="o_oteny_home_toggle" data-hotkey="h" title="Home"
                t-on-click.prevent="openHomeScreen">
                <i class="oi oi-apps"/>
            </a>
        </xpath>
    </t>

    <!-- The name of the app next to the apps button also opens the home screen. -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(@class, 'o_menu_brand')]" position="attributes">
            <attribute name="onSelected">() => this.openHomeScreen()</attribute>
            <attribute name="attrs">{ href: '/odoo/home', 'data-menu-xmlid': currentApp.xmlid, 'data-section': currentApp.id }</attribute>
        </xpath>
    </t>

</templates>
