<?xml version="1.0"?>
<odoo noupdate="1">
    <!--
        Send Notification workflow: identical states to Send Email, but the
        primary "Send" transition goes directly to Done (fast path).
        Awaiting Reply is kept as a secondary path for cases where a reply
        is expected.  Designed for one-shot notification emails.
    -->

    <!-- Workflow -->
    <record id="workflow_service_send_notification" model="riverflow.workflow">
        <field name="model_id" ref="riverflow.model_riverflow_service" />
        <field name="name">Send Notification</field>
        <field name="description">Workflow for sending one-shot notification emails (fast path to Done)</field>
        <!-- Bell, not envelope: Send Email (await-reply) owns fa-envelope and
             both workflows sit side by side in the same picker — the bell marks
             this as the one-shot notification variant. -->
        <field name="icon">fa-bell</field>
    </record>

    <!-- States -->
    <record id="state_service_sn_not_started" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_send_notification" />
        <field name="name">Not Started</field>
        <field name="sequence">10</field>
        <field name="color_int">5</field>
    </record>
    <record id="state_service_sn_awaiting_reply" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_send_notification" />
        <field name="name">Awaiting Reply</field>
        <field name="sequence">20</field>
        <field name="color_int">5</field>
    </record>
    <record id="state_service_sn_done" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_send_notification" />
        <field name="name">Done</field>
        <field name="sequence">30</field>
        <field name="is_end_state">True</field>
        <field name="color_int">5</field>
    </record>
    <record id="state_service_sn_not_needed" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_send_notification" />
        <field name="name">Not Needed</field>
        <field name="sequence">40</field>
        <field name="is_end_state">True</field>
        <field name="hide_in_statusbar">True</field>
        <field name="color_int">5</field>
    </record>

    <!-- Transitions -->
    <!-- Transitions from no state -->
    <record id="trans_sn_initial" model="riverflow.transition">
        <field name="name">Start</field>
        <field name="from_state_id" ref="" />
        <field name="to_state_id" ref="state_service_sn_not_started" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="sequence">10</field>
    </record>

    <!-- Transitions from state Not Started -->
    <record id="trans_sn_send" model="riverflow.transition">
        <field name="name">Send</field>
        <field name="from_state_id" ref="state_service_sn_not_started" />
        <field name="to_state_id" ref="state_service_sn_done" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="sequence">10</field>
    </record>
    <record id="trans_sn_send_and_await" model="riverflow.transition">
        <field name="name">Send and Await Reply</field>
        <field name="from_state_id" ref="state_service_sn_not_started" />
        <field name="to_state_id" ref="state_service_sn_awaiting_reply" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="sequence">20</field>
    </record>
    <record id="trans_sn_sent_already" model="riverflow.transition">
        <field name="name">Sent already</field>
        <field name="from_state_id" ref="state_service_sn_not_started" />
        <field name="to_state_id" ref="state_service_sn_done" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="sequence">30</field>
    </record>
    <record id="trans_sn_not_needed" model="riverflow.transition">
        <field name="name">Not Needed</field>
        <field name="from_state_id" ref="state_service_sn_not_started" />
        <field name="to_state_id" ref="state_service_sn_not_needed" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <!-- Executed by itself when the parent service enters a state that
             ends the case (execute_child_transitions = cancel). The file is
             noupdate: migration 19.0.1.1393. -->
        <field name="execute_on_parent_transitions">cancel</field>
        <field name="sequence">40</field>
    </record>

    <!-- Transitions from state Awaiting Reply -->
    <record id="trans_sn_awaiting_reply_to_done" model="riverflow.transition">
        <field name="name">Mark as Done</field>
        <field name="from_state_id" ref="state_service_sn_awaiting_reply" />
        <field name="to_state_id" ref="state_service_sn_done" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="sequence">10</field>
    </record>
    <record id="trans_sn_awaiting_reply_resend" model="riverflow.transition">
        <field name="name">Resend</field>
        <field name="from_state_id" ref="state_service_sn_awaiting_reply" />
        <field name="to_state_id" ref="state_service_sn_awaiting_reply" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="sequence">20</field>
    </record>

    <!-- Transitions from state Done -->
    <record id="trans_sn_done_resend" model="riverflow.transition">
        <field name="name">Resend</field>
        <field name="from_state_id" ref="state_service_sn_done" />
        <field name="to_state_id" ref="state_service_sn_awaiting_reply" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="sequence">10</field>
    </record>
    <record id="trans_sn_done_to_awaiting_reply_back" model="riverflow.transition">
        <field name="name">Back to Awaiting Reply</field>
        <field name="from_state_id" ref="state_service_sn_done" />
        <field name="to_state_id" ref="state_service_sn_awaiting_reply" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="sequence">20</field>
    </record>

    <!-- Transitions from state Not Needed -->
    <record id="trans_sn_not_needed_send" model="riverflow.transition">
        <field name="name">Send email after all</field>
        <field name="from_state_id" ref="state_service_sn_not_needed" />
        <field name="to_state_id" ref="state_service_sn_done" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="sequence">10</field>
    </record>
</odoo>
