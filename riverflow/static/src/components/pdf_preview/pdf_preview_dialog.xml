<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="riverflow.PdfPreviewDialog">
        <Dialog title="props.title" size="'lg'" withBodyPadding="false"
                contentClass="'o_riverflow_pdf_preview'">
            <iframe class="o_riverflow_pdf_preview_frame" t-att-src="viewerUrl"
                    t-att-title="props.title" t-ref="iframe"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onPrint">
                    <i class="fa fa-print me-1"/>Print
                </button>
                <button class="btn btn-secondary" t-on-click="onDownload">
                    <i class="fa fa-download me-1"/>Download
                </button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
