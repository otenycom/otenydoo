<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The apps button and the name of the open app are one link to the home
         screen, as in Odoo Enterprise: a hover on either turns the grid into a
         back arrow (the o_menu_toggle styles of web's navbar.scss). The home
         screen hides the link, as Enterprise hides it on its home menu. -->
    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]/Dropdown" position="replace">
            <a t-if="!isHomeScreenOpen" href="/odoo/home" class="o_menu_toggle border-0" data-hotkey="h" title="Home"
                t-on-click.prevent="openHomeScreen">
                <svg class="o_menu_toggle_icon pe-none" width="14px" height="14px" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                    <g t-foreach="[0, 5, 10]" t-as="Y" t-att-id="'o_menu_toggle_row_' + Y_index" fill="currentColor" t-key="'o_menu_toggle_row_' + Y_index">
                        <rect t-foreach="[0, 5, 10]" t-as="X" width="3" height="3" t-att-x="X" t-att-y="Y" t-key="'o_menu_toggle_cell_' + X_index"/>
                    </g>
                </svg>
                <span t-if="currentApp" t-esc="currentApp.name" class="o_menu_brand d-flex ms-3 pe-0"/>
            </a>
        </xpath>
    </t>

    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(@class, 'o_menu_brand')]" position="replace"/>
    </t>

</templates>
