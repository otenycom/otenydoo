<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Run Transition on many records (radar plan credential-end-follow-up, D9a). -->
    <record id="view_bulk_transition_wizard_form" model="ir.ui.view">
        <field name="name">riverflow.bulk.transition.wizard.form</field>
        <field name="model">riverflow.bulk.transition.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Transition">
                <div class="alert alert-info" role="alert" invisible="not note">
                    <field name="note" nolabel="1" />
                </div>
                <p>Choose the transition to run on the selected records. The number says on how many it runs; the next
                    screen names the records that are left out.</p>
                <field name="record_count" invisible="1" />
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="label" string="Transition" />
                        <button name="action_choose" type="object" string="Choose" class="btn-primary" />
                    </list>
                </field>
                <footer>
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action > Run Transition on the services list and on the Radar list. A
         module binds the same server action to its own workflow model. -->
    <record id="action_bulk_transition_service" model="ir.actions.server">
        <field name="name">Run Transition</field>
        <field name="model_id" ref="model_riverflow_service" />
        <field name="binding_model_id" ref="model_riverflow_service" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env["riverflow.bulk.transition.wizard"]._open_for(records)</field>
    </record>
    <record id="action_bulk_transition_state_record" model="ir.actions.server">
        <field name="name">Run Transition</field>
        <field name="model_id" ref="model_riverflow_state_record" />
        <field name="binding_model_id" ref="model_riverflow_state_record" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env["riverflow.bulk.transition.wizard"]._open_for(records)</field>
    </record>
</odoo>
