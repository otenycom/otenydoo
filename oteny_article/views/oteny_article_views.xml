<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oteny_article_list" model="ir.ui.view">
        <field name="name">oteny.article.list</field>
        <field name="model">oteny.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="icon" string=" " width="30px" />
                <field name="name" />
                <field name="parent_id" optional="show" />
                <field name="root_article_id" optional="hide" />
                <field name="is_locked" optional="show" />
                <field name="write_date" string="Last Changed" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_oteny_article_form" model="ir.ui.view">
        <field name="name">oteny.article.form</field>
        <field name="model">oteny.article</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <h1 class="d-flex gap-2">
                            <field name="icon" class="flex-grow-0" style="width: 2.5em;" readonly="is_locked" />
                            <field name="name" placeholder="Article title" readonly="is_locked" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" readonly="is_locked" />
                        </group>
                        <group>
                            <field name="is_locked" groups="base.group_system" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Article" name="body">
                            <field name="body" readonly="is_locked" options="{'collaborative': false}" />
                        </page>
                        <page string="Child Articles" name="children">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="icon" string=" " width="30px" />
                                    <field name="name" />
                                    <field name="is_locked" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_oteny_article_search" model="ir.ui.view">
        <field name="name">oteny.article.search</field>
        <field name="model">oteny.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="body" />
                <field name="parent_id" operator="child_of" />
                <filter string="Top Level" name="top_level" domain="[('parent_id', '=', False)]" />
                <filter string="Locked" name="locked" domain="[('is_locked', '=', True)]" />
                <separator />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <group>
                    <filter string="Root Article" name="group_root" context="{'group_by': 'root_article_id'}" />
                    <filter string="Parent Article" name="group_parent" context="{'group_by': 'parent_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_oteny_article" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">oteny.article</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_root': 1}</field>
    </record>

    <menuitem id="menu_oteny_article_root" name="Articles" action="action_oteny_article" sequence="85"
        web_icon="oteny_article,static/description/icon.svg" />
</odoo>
