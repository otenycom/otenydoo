<?xml version="1.0"?>
<odoo noupdate="1">
    <!-- Workflow -->
    <record id="workflow_service_taxi_order" model="riverflow.workflow">
        <field name="model_id" ref="riverflow.model_riverflow_service" />
        <field name="name">Taxi Supply Order</field>
        <field name="description">Workflow for managing taxi orders</field>
        <field name="icon">fa-taxi</field>
        <field name="is_supply_order">True</field>
        <field name="has_supply_quantity">False</field>
        <field name="has_supplier">True</field>
        <field name="has_supply_unit_price">False</field>
        <field name="has_legs">True</field>
        <field name="has_supply_time">True</field>
    </record>

    <!-- Define all states first (to prevent forward references) -->
    <record id="state_taxi_not_started" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_taxi_order" />
        <field name="name">Not Started</field>
        <field name="sequence">10</field>
        <field name="color_int">7</field>
    </record>

    <record id="state_taxi_ordered" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_taxi_order" />
        <field name="name">Ordered</field>
        <field name="sequence">20</field>
        <field name="color_int">7</field>
    </record>

    <record id="state_taxi_confirmed" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_taxi_order" />
        <field name="name">Confirmed by Supplier</field>
        <field name="sequence">30</field>
        <field name="color_int">7</field>
    </record>

    <record id="state_taxi_registered" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_taxi_order" />
        <field name="name">Registered</field>
        <field name="sequence">40</field>
        <field name="color_int">2</field>
        <field name="is_end_state" eval="True" />
        <field name="is_back_office_state" eval="True" />
    </record>

    <record id="state_taxi_cancelled" model="riverflow.state">
        <field name="workflow_id" ref="workflow_service_taxi_order" />
        <field name="name">Cancelled</field>
        <field name="sequence">50</field>
        <field name="hide_in_statusbar">True</field>
        <field name="is_cancelled_state">True</field>
        <field name="is_end_state">True</field>
        <field name="color_int">1</field>
    </record>

    <!-- Then define all transitions -->
    <record id="trans_taxi_initial_to_not_started" model="riverflow.transition">
        <field name="name">Not Started</field>
        <field name="from_state_id" ref="" />
        <field name="to_state_id" ref="state_taxi_not_started" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="sequence">10</field>
        <field name="action_context">{
            "default_supply_quantity": 0,
            }</field>
    </record>

    <!-- Transitions from Not Started -->
    <record id="trans_taxi_not_started_email_to_ordered" model="riverflow.transition">
        <field name="name">Order Now</field>
        <field name="from_state_id" ref="state_taxi_not_started" />
        <field name="to_state_id" ref="state_taxi_ordered" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="icon">fa-taxi</field>
        <field name="sequence">10</field>
        <field name="to_responsible_team_id" ref="riverflow.partner_team_logistics" />
    </record>

    <record id="trans_taxi_skip_send_not_started_to_ordered" model="riverflow.transition">
        <field name="name">Ordered already</field>
        <field name="from_state_id" ref="state_taxi_not_started" />
        <field name="to_state_id" ref="state_taxi_confirmed" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="icon">fa-taxi</field>
        <field name="sequence">20</field>
        <field name="to_responsible_team_id" ref="riverflow.partner_team_logistics" />
    </record>

    <record id="trans_taxi_skip_send_not_started_to_confirmed" model="riverflow.transition">
        <field name="name">Confirmed by Supplier</field>
        <field name="from_state_id" ref="state_taxi_not_started" />
        <field name="to_state_id" ref="state_taxi_confirmed" />
        <field name="action_id" ref="riverflow.transition_action_supplier_confirmed" />
        <field name="icon">fa-check</field>
        <field name="sequence">30</field>
    </record>

    <record id="trans_taxi_not_started_to_cancelled" model="riverflow.transition">
        <field name="name">Cancel</field>
        <field name="from_state_id" ref="state_taxi_not_started" />
        <field name="to_state_id" ref="state_taxi_cancelled" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <!-- Executed by itself when the parent service enters a state that
             ends the case (execute_child_transitions = cancel). -->
        <field name="execute_on_parent_transitions">cancel</field>
        <field name="icon">fa-times</field>
        <field name="sequence">40</field>
    </record>

    <!-- Transitions from Ordered -->
    <record id="trans_taxi_ordered_to_confirmed" model="riverflow.transition">
        <field name="name">Confirmed</field>
        <field name="from_state_id" ref="state_taxi_ordered" />
        <field name="to_state_id" ref="state_taxi_confirmed" />
        <field name="action_id" ref="riverflow.transition_action_supplier_confirmed" />
        <field name="icon">fa-check</field>
        <field name="sequence">10</field>
    </record>

    <record id="trans_taxi_ordered_to_registered" model="riverflow.transition">
        <field name="name">Register</field>
        <field name="from_state_id" ref="state_taxi_ordered" />
        <field name="to_state_id" ref="state_taxi_registered" />
        <field name="action_id" ref="riverflow.transition_action_register_service" />
        <field name="icon">fa-book</field>
        <field name="sequence">20</field>
        <field name="to_responsible_team_id" ref="riverflow.partner_team_finance" />
        <field name="action_context">{ }</field>
    </record>

    <record id="trans_taxi_ordered_to_ordered" model="riverflow.transition">
        <field name="name">Re-order</field>
        <field name="from_state_id" ref="state_taxi_ordered" />
        <field name="to_state_id" ref="state_taxi_ordered" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="icon">fa-refresh</field>
        <field name="sequence">30</field>
    </record>

    <record id="trans_taxi_ordered_to_cancelled" model="riverflow.transition">
        <field name="name">Cancel</field>
        <field name="from_state_id" ref="state_taxi_ordered" />
        <field name="to_state_id" ref="state_taxi_cancelled" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="icon">fa-times</field>
        <field name="sequence">40</field>
    </record>

    <!-- Transitions from Confirmed -->
    <record id="trans_taxi_confirmed_to_registered" model="riverflow.transition">
        <field name="name">Register</field>
        <field name="from_state_id" ref="state_taxi_confirmed" />
        <field name="to_state_id" ref="state_taxi_registered" />
        <field name="action_id" ref="riverflow.transition_action_register_service" />
        <field name="sequence">10</field>
        <field name="to_responsible_team_id" ref="riverflow.partner_team_finance" />
        <field name="action_context">{ "default_supply_quantity_required": False }</field>
    </record>

    <record id="trans_taxi_confirmed_to_ordered" model="riverflow.transition">
        <field name="name">Re-send order</field>
        <field name="from_state_id" ref="state_taxi_confirmed" />
        <field name="to_state_id" ref="state_taxi_ordered" />
        <field name="action_id" ref="riverflow.transition_action_email_sender" />
        <field name="sequence">20</field>
    </record>

    <record id="trans_taxi_confirmed_to_cancelled" model="riverflow.transition">
        <field name="name">Cancel</field>
        <field name="from_state_id" ref="state_taxi_confirmed" />
        <field name="to_state_id" ref="state_taxi_cancelled" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="sequence">30</field>
    </record>

    <!-- Transitions from Registered -->
    <record id="trans_taxi_registered_to_confirmed" model="riverflow.transition">
        <field name="name">Return to Confirmed</field>
        <field name="from_state_id" ref="state_taxi_registered" />
        <field name="to_state_id" ref="state_taxi_confirmed" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="icon">fa-pencil</field>
        <field name="sequence">10</field>
        <field name="to_responsible_team_id" ref="riverflow.partner_team_logistics" />
    </record>

    <!-- Transitions from Cancelled -->
    <record id="trans_taxi_cancelled_to_not_started" model="riverflow.transition">
        <field name="name">Restart</field>
        <field name="from_state_id" ref="state_taxi_cancelled" />
        <field name="to_state_id" ref="state_taxi_not_started" />
        <field name="action_id" ref="riverflow.transition_action_default" />
        <field name="icon">fa-undo</field>
        <field name="sequence">10</field>
    </record>

</odoo>