<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- First migration and catch-up after a bucket outage are the same job. -->
    <record id="ir_cron_cloud_filestore_upload" model="ir.cron">
        <field name="name">Cloud filestore: upload local files to the bucket</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._cloud_filestore_upload_pending()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
