<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- One finding: its subject (e.g. the file it is about), then its message. -->
    <t t-name="riverflow.SaveCheckField.finding">
        <t t-if="finding.subject"><b t-esc="finding.subject"/>: </t><t t-esc="finding.message"/>
    </t>

    <!-- A box per level. One finding is one line; two or more are a numbered
         list, so the user can tell them apart (Ries, 10-Oct-2026). -->
    <t t-name="riverflow.SaveCheckField.box">
        <ol t-if="items.length gt 1" class="mb-0 ps-3">
            <li t-foreach="items" t-as="finding" t-key="finding_index" t-att-class="itemClass" style="white-space: pre-wrap;">
                <t t-call="riverflow.SaveCheckField.finding"/>
            </li>
        </ol>
        <t t-else="">
            <div t-foreach="items" t-as="finding" t-key="finding_index" t-att-class="itemClass" style="white-space: pre-wrap;">
                <t t-call="riverflow.SaveCheckField.finding"/>
            </div>
        </t>
    </t>

    <t t-name="riverflow.SaveCheckField">
        <div class="o_riverflow_save_check w-100">
            <div t-if="errors.length" class="alert alert-danger mb-2" role="alert">
                <t t-call="riverflow.SaveCheckField.box">
                    <t t-set="items" t-value="errors"/>
                    <t t-set="itemClass" t-value="'o_riverflow_save_check_error'"/>
                </t>
            </div>
            <div t-if="warnings.length" class="alert alert-warning mb-2" role="alert">
                <t t-call="riverflow.SaveCheckField.box">
                    <t t-set="items" t-value="warnings"/>
                    <t t-set="itemClass" t-value="'o_riverflow_save_check_warning'"/>
                </t>
            </div>
        </div>
    </t>
</templates>
