<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="workflow_view_form" model="ir.ui.view">
        <field name="name">riverflow.workflow.form</field>
        <field name="model">riverflow.workflow</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="reset_workflow_to_xml" type="object"
                        string="Reset to XML" icon="fa-refresh"
                        confirm="Reset all states and transitions to their XML definitions? Manual changes will be lost and manually-added records will be archived."
                        class="oe_highlight" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="active" invisible="True" />
                            <field name="name" class="w-100" on_change="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" on_change="1" />
                            <field name="description" />
                            <field name="icon" on_change="1" />
                            <field name="icon_name_html" readonly="1" />
                        </group>
                        <group>
                            <field name="is_supply_order" />
                            <field name="has_supply_quantity" />
                            <field name="has_supply_unit_price" />
                            <field name="has_supplier" />
                            <field name="has_legs" />
                            <field name="has_supply_time" />
                            <field name="auto_complete_state_id" />
                            <field name="enforce_single_open" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Start Transitions" name="start_transitions">
                            <div>
                                <button name="workflow_add_start_transition" type="object" class="oe_link" data-hotkey="n"
                                    icon="fa-plus">
                                    Add Start Transition</button>
                            </div>
                            <field name="workflow_start_transition_ids" default_order="sequence,name,id" widget="riverflow_one2many">
                                <list create="0" delete="0" edit="0">
                                    <field name="active" column_invisible="True" />
                                    <field name="workflow_id" column_invisible="True" />
                                    <field name="sequence" widget="handle" />
                                    <field name="name" readonly="1" />
                                    <field name="to_state_id" readonly="1" />
                                    <field name="description" readonly="1" />
                                </list>
                            </field>
                        </page>
                        <page string="States" name="states">
                            <div>
                                <button name="workflow_add_state" type="object" class="oe_link" data-hotkey="n"
                                    icon="fa-plus">
                                    Add State</button>
                            </div>
                            <field name="state_ids" default_order="sequence,name,id" widget="riverflow_one2many">
                                <list create="0" delete="0" edit="0">
                                    <field name="active" column_invisible="True" />
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="color_int" widget="color_picker" />
                                    <field name="description" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="workflow_view_list" model="ir.ui.view">
        <field name="name">riverflow.workflow.list</field>
        <field name="model">riverflow.workflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="active" column_invisible="True" />
                <field name="model" optional="show" />
                <field name="icon_name_html" />
                <field name="name" optional="hide" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="workflow_action" model="ir.actions.act_window">
        <field name="name">Workflows</field>
        <field name="path">workflows</field>
        <field name="res_model">riverflow.workflow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new workflow!
            </p>
        </field>
    </record>

    <menuitem id="riverflow.services_menu_configuration_workflows"
        parent="riverflow.services_configuration_menu" sequence="20"
        action="riverflow.workflow_action" />

</odoo>