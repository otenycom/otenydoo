<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The daily clean-up deletes a record when nobody met its fault for this many days. -->
    <record id="param_max_age_days" model="ir.config_parameter">
        <field name="key">oteny_oops.max_age_days</field>
        <field name="value">30</field>
    </record>
</odoo>
