<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="transition_view_form" model="ir.ui.view">
        <field name="name">riverflow.transition.form</field>
        <field name="model">riverflow.transition</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" on_change="1" />
                        <h1>
                            <field name="active" invisible="True" />
                            <field name="name" class="w-100" on_change="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model" invisible="1" />
                            <field name="workflow_id" readonly="1" />
                            <field name="description" />
                            <field name="icon" on_change="1" />
                            <field name="icon_name_html" readonly="1" />
                            <field name="from_state_id" invisible="context.get('is_start_transition', False)" />
                            <field name="to_state_id" />
                            <field name="action_id" required="1" />
                            <field name="to_responsible_team_id" />
                            <field name="action_context" />
                            <field name="execute_on_parent_transitions" />
                            <field name="mail_template_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="transition_view_list" model="ir.ui.view">
        <field name="name">riverflow.transition.list</field>
        <field name="model">riverflow.transition</field>
        <field name="arch" type="xml">
            <!-- Workaround: no sequence drag widget, as side effect  is that the transitions 
                 can be moved around beyond the from_state that they belong to.
                 Setting <list default_order="workflow_id,from_state_id,sequence,name,id"> does not fix this.
            -->
            <list>
                <field name="active" column_invisible="True" />
                <!-- <field name="sequence" widget="handle" /> -->
                <field name="workflow_id" />
                <field name="name" optional="hide" />
                <field name="display_name" optional="hide" />
                <field name="icon_name_html" optional="show" />
                <field name="icon" optional="hide" />
                <field name="from_state_id" />
                <field name="to_state_id" />
                <field name="action_id" />
                <field name="to_responsible_team_id" optional="hide" />
                <field name="action_context" optional="hide" />
                <field name="execute_on_parent_transitions" optional="hide" />
                <field name="mail_template_id" optional="hide" />
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="transition_action" model="ir.actions.act_window">
        <field name="name">Transitions</field>
        <field name="path">transitions</field>
        <field name="res_model">riverflow.transition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new workflow transition!
            </p>
        </field>
    </record>

    <menuitem id="riverflow.services_menu_configuration_transitions"
        parent="riverflow.services_configuration_menu" sequence="40"
        action="riverflow.transition_action" />

</odoo>